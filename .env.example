# Obrigatórias para Auth/dados; copie para .env.local e configure seu projeto.
# URL e chave publicável/anon são configuração pública, nunca service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional, somente servidor: sugestão do nome da empresa no relatório.
OP_DIGITAL_COMPANY_NAME=

# Ferramentas locais opcionais. Não são necessárias na Vercel.
# SUPABASE_CLI=
# SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# Somente seed local: forneça ao processo, não armazene senha neste arquivo.
# OP_DIGITAL_DEMO_PASSWORD=
